
{% set interfaces = property_sets.system_properties.interfaces %}
{% set vlans = property_sets.system_properties.vlans %}
interfaces {
    {% for ifname, ifprops in interfaces.items() %}
    {% if 'ae_member_of' in ifprops %}
    replace: {{ ifname }} {
        gigether-options {
            802.3ad {{ ifprops.ae_member_of }};
        }
    }
    {% elif ifname.startswith('ae') %}
    replace: {{ ifname }} {
        esi {
            auto-derive {
                type-1-lacp;
            }
            all-active;
        }
        aggregated-ether-options {
            lacp {
                {{ ifprops.lag.mode }};
                system-id {{ ifprops.lag.system_id }};
            }
        }
        unit 0 {
            family ethernet-switching {
                interface-mode {{ ifprops.ethernet_switching.mode | default('access') }};
                vlan {
                    members {{ ifprops.ethernet_switching.vlan }};
                }
            }
        }
        mtu 9192;
    }
    {% elif ifprops.l3 == "yes" and ifprops.irb == "no" and ifname.startswith('lo0') %}
    replace: {{ ifname }} {
        unit 0 {
            family inet {
                address {{ ifprops.address }};
            }
        }
    }
    {% elif ifprops.l3 == "yes" and ifprops.irb == "no" and not ifname.startswith('lo0') %}
    replace: {{ ifname }} {
        unit 0 {
            family inet {
                address {{ ifprops.address }};
            }
        }
        mtu 9192;
    }
    {% else %}
    replace: {{ ifname }} {
        unit 0 {
            family ethernet-switching {
                interface-mode {{ ifprops.ethernet_switching.mode | default('access') }};
                vlan {
                    members {{ ifprops.ethernet_switching.vlan }};
                }
            }
        }
        mtu 9192;
    }
    {% endif %}
    {% endfor %}
    {% if property_sets.system_properties.crb_enabled %}
    replace: irb {
        {% for vlan in vlans %}
        unit {{ vlans[vlan].irb.unit }} {
            proxy-macip-advertisement;
            {% if vlans[vlan].irb.virtual_gateway_accept_data | default(false) %}
            virtual-gateway-accept-data;
            {% endif %}
            family inet {
                address {{ vlans[vlan].irb.address }} {
                    virtual-gateway-address {{ vlans[vlan].irb.virtual_gateway }};
                }
            }
        }
        {% endfor %}
    }
    {% endif %}
}
