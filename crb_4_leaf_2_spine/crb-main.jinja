        encrypted-password "$6$OWnpR5nW$J8WCRH0Fflv0tV6peeHfzZq8bz8BUp8CRyO/pYzuQFe5v8sMvYU6cLZHETSHlqSZX1BUng8xc6kcaJ/RuLe6p."; ## SECRET-DATA
    }
    login {
        user admin {
